{
  "name": "containerized-app",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "node:build": "tsc --project tsconfig.json",
    "node:start": "node ./build/index.js",
    "docker:build": "docker build -t my-node-app .",
    "docker:run": "docker run -p 80:80 my-node-app"
},
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "jest": "^30",
    "aws-cdk": "2.1148.1",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.5.0"
  }
}
